# Copy to .env.local for local development. Never commit real values.

# Database (Supabase > Project Settings > Database > Connection string > "Transaction pooler")
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# App login and encryption (make each one a long random string)
APP_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=

# Web push (npm run vapid prints a pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Only needed where mail is read: GitHub Secrets (and Vercel if you want the "Check mail now" button)
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5

# Optional backup notifications
PUSHOVER_TOKEN=
PUSHOVER_USER=
APP_URL=https://your-app.vercel.app
